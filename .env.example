# Every variable the API, worker, and migrator read. Local development needs none of them: the
# defaults below match docker-compose.yml. In production DATABASE_URL, REDIS_URL, and JWT_SECRET
# are required and the process refuses to start without them.

DATABASE_URL=postgres://parking:parking@localhost:5432/parking
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
PORT=3000

# development | test | production. Controls cookie Secure flag, mock login default, required variables.
NODE_ENV=development
# Password-less login for seeded users. Default: true outside production, false in production.
# Enabling it in production logs a startup warning; the container rehearsal does so on purpose.
MOCK_AUTH=true

# Rotation worker (pnpm scheduler): cron in UTC and how many days before a cycle starts it is drawn.
ROTATION_CRON=0 6 * * *
DRAW_LEAD_DAYS=7

# pino level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Where the migrator finds the SQL; defaults to packages/db/drizzle from source, /app/drizzle in the image.
# MIGRATIONS_DIR=
# Integration tests use their own database, derived from DATABASE_URL with the name parking_test.
# TEST_DATABASE_URL=
