{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "PORT",
    "NODE_ENV",
    "MOCK_AUTH",
    "ROTATION_CRON",
    "DRAW_LEAD_DAYS",
    "LOG_LEVEL",
    "MIGRATIONS_DIR",
    "TEST_DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
