# Rendered by the nginx image's envsubst at startup; ${API_UPSTREAM} comes from the environment.
# The unprivileged image listens on 8080 and runs as uid 101.
server_tokens off;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    include /etc/nginx/snippets/security-headers.conf;

    # Hashed assets are immutable; index.html must always be revalidated.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Operational endpoints stay inside the network: never reachable through the public edge.
    location = /api/metrics {
        return 404;
    }

    # Same-origin API: the browser never sees a second host, so the session cookie stays first-party.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        # The edge is authoritative for browser security headers; drop the API's own copies so
        # browsers never see two conflicting values (the API sets them for direct callers).
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Cross-Origin-Resource-Policy;
        proxy_hide_header Origin-Agent-Cluster;
        proxy_hide_header X-Download-Options;
        proxy_hide_header X-Permitted-Cross-Domain-Policies;
        proxy_hide_header X-DNS-Prefetch-Control;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
    }

    location = /healthz {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Type text/plain always;
        return 200 "ok\n";
    }

    # Single-page app: unknown paths fall back to index.html.
    location / {
        try_files $uri /index.html;
    }
}
